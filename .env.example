# Copy this file to .env and fill in the values. .env is git-ignored.
# Never paste these values into chat or commit them.

# Postgres connection string (Neon: use the "pooled" or direct string, keep sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Cloud OAuth client of type "Desktop app" (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How many days of mail to pull the first time an account is synced
INITIAL_SYNC_DAYS=14

# Only needed where there is no tokens/ folder (GitHub Actions, Phase 4):
# a JSON object mapping each Gmail address to its refresh token.
# Locally, `python -m ingest.authorize` writes tokens/<address>.json instead.
# GMAIL_REFRESH_TOKENS={"you@gmail.com": "..."}

# Optional: a second database used only by the integration tests (its tables are dropped!)
# TEST_DATABASE_URL=
